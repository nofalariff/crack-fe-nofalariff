# === LogiSend Frontend ===
# Salin berkas ini menjadi .env.local lalu sesuaikan nilainya.

# URL backend REST API (logisend-api). Hanya dipakai di server, tidak diekspos ke browser.
API_URL=http://localhost:3001/api/v1

# URL publik aplikasi ini (dipakai untuk metadata & Open Graph).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Nama aplikasi yang tampil di UI.
NEXT_PUBLIC_APP_NAME=LogiSend

# Nyalakan mock MSW selama backend belum tersedia: "enabled" | "disabled".
# Saat backend asli sudah siap, ubah menjadi "disabled" dan isi API_URL di atas.
NEXT_PUBLIC_API_MOCKING=enabled
